{
  "manifest_version": 3,
  "name": "Web MCP Approval Helper",
  "version": "0.2.0",
  "description": "Highlight trusted MCP approval dialogs on ChatGPT / Claude / Grok and auto-approve or confirm with a hotkey. Aligned with coding-tools-mcp 0.3.0 tool catalog.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["grok-autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
